{
  "name": "ai-powered-finance-agent",
  "version": "0.1.0",
  "description": "Intent-routing finance agent with a Turkish and US market data layer. Most sources need no API key.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
