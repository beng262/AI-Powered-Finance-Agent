    "finra",
    "cboe",
    "yahoo-finance",
    "agent",
    "intent-routing",
    "typescript"
  ],
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "author": "Bengisu Saraç <bengsrc@gmail.com> (https://beng262.github.io)",
  "homepage": "https://beng262.github.io/AI-Powered-Finance-Agent/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beng262/AI-Powered-Finance-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/beng262/AI-Powered-Finance-Agent/issues"
  },
